# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (NOWPayments) ──────────────────────────────────────────────────
# https://account.nowpayments.io → Store settings → API keys
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
# Base URL is chosen automatically (sandbox when using PAYMENT_PROVIDER=sandbox)
PAYMENT_PROVIDER=sandbox

# ── Email (Resend) — optional ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Lumina <noreply@yourdomain.com>"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron (Vercel Cron calls /api/cron/daily with this bearer token) ─────────
CRON_SECRET=

# ── Bootstrap (run once via `npm run bootstrap`, then remove) ───────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CREATOR_EMAIL=
BOOTSTRAP_CREATOR_PASSWORD=
